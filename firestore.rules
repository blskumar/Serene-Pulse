rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data, userId) {
      return data.userId == userId &&
        data.userId == request.auth.uid &&
        data.email is string &&
        data.email.size() <= 256 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024)) &&
        data.keys().hasAll(['userId', 'email']) &&
        data.keys().hasOnly(['userId', 'email', 'displayName', 'photoURL', 'createdAt']);
    }

    function isValidJournalEntry(data, userId) {
      return data.userId == userId &&
        data.userId == request.auth.uid &&
        data.id is string && isValidId(data.id) &&
        data.sessionId is string && data.sessionId.size() <= 128 &&
        data.sessionTitle is string && data.sessionTitle.size() <= 256 &&
        data.durationMinutes is number && data.durationMinutes >= 0 && data.durationMinutes <= 1440 &&
        data.stressBefore is number && data.stressBefore >= 1 && data.stressBefore <= 10 &&
        data.calmnessAfter is number && data.calmnessAfter >= 1 && data.calmnessAfter <= 10 &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 4000)) &&
        (!('date' in data) || (data.date is string && data.date.size() <= 64)) &&
        data.keys().hasAll(['id', 'userId', 'sessionId', 'sessionTitle', 'durationMinutes', 'stressBefore', 'calmnessAfter']) &&
        data.keys().hasOnly(['id', 'userId', 'sessionId', 'sessionTitle', 'date', 'durationMinutes', 'stressBefore', 'calmnessAfter', 'notes', 'createdAt']);
    }

    // User Profile
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(incoming(), userId);
      allow update: if isOwner(userId) && isValidUserProfile(incoming(), userId) && incoming().userId == existing().userId;
      allow delete: if isOwner(userId);

      // Journal Entries Subcollection
      match /journalEntries/{entryId} {
        allow get: if isOwner(userId) && isValidId(entryId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(entryId) && isValidJournalEntry(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(entryId) && isValidJournalEntry(incoming(), userId) && incoming().userId == existing().userId && incoming().id == existing().id;
        allow delete: if isOwner(userId) && isValidId(entryId);
      }
    }
  }
}
